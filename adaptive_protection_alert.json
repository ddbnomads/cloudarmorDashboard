# gcloud alpha monitoring policies create --policy-from-file=adaptive_protection_alert.json

{
  "displayName": "Cloud Armor Adaptive Protection Alert",
  "conditions": [
    {
      "displayName": "Adaptive Protection - Attack Detected",
      "conditionMatchedLog": {
        "filter": "resource.type=\"network_security_policy\" AND logName=\"projects/[projectName]/logs/networksecurity.googleapis.com%2Fadaptive_protection_events\" AND jsonPayload.threatVerdict.verdict=\"ATTACK\"",
        "resourceContainers": [
          "projects/[projectName]"
        ]
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "3600s"
    },
    "autoClose": "604800s"
  },
  "combiner": "OR",
  "enabled": true,
  "documentation": {
    "content": "This alert fires when Cloud Armor Adaptive Protection detects a potential DDoS attack. Check the Cloud Armor monitoring and logs in the reisfeldplayground project for details.",
    "mimeType": "text/markdown"
  }
}


  
